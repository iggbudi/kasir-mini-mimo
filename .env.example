# Turso Database
# Local: file:db/kasir.db
# Remote: libsql://YOUR_DB.turso.io
TURSO_DATABASE_URL=file:db/kasir.db
TURSO_AUTH_TOKEN=

# Server
PORT=3000

# Auth
SESSION_HOURS=12

# Rate limit login (default: 5 percobaan / 15 menit / lock 15 menit)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SEC=900
LOGIN_LOCK_SEC=900

# Admin (dipakai saat db:init)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
