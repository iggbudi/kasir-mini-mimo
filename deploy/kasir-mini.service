[Unit]
Description=Kasir Mini (kasir-mini-mimo)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kasir-mini-mimo
EnvironmentFile=/home/ubuntu/kasir-mini-mimo/.env
Environment=NODE_ENV=production
Environment=PORT=3001
ExecStart=/bin/bash -c 'export PORT=3001; exec /home/ubuntu/.nvm/versions/node/v24.19.0/bin/node server.js'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
